APP_NAME=ConexBase
APP_ENV=local
# Vacía a propósito: docker/entrypoint.sh genera una clave propia en cada computador.
# Nunca subas una clave real al repositorio (es público).
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos (coincide con docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ConexBase
DB_USERNAME=root
DB_PASSWORD=1234

# La API no usa sesiones de navegador; "file" evita depender de tablas extra
SESSION_DRIVER=file
# Caché en MySQL (tablas cache y cache_locks); ver docs/datos
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Orígenes del frontend permitidos (CORS), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
