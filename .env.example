APP_NAME=ConexBase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos (coincide con docker-compose.yml)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ConexBase
DB_USERNAME=root
DB_PASSWORD=1234

# La API no usa sesiones de navegador; "file" evita depender de tablas extra
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Orígenes del frontend permitidos (CORS), separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
